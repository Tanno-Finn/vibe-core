# Environment Variables Template
# Copy this file to `.env` and fill in your values.
# .env is gitignored — never commit it.

# The kit needs no environment variables to run. What follows is opt-in, and left
# switched off: PRIV-003 puts anything that reports outward off by default, and that
# applies to the kit's own tooling too, not only to features you build with it.

# Public base URL of the deployed site, e.g. https://example.org
# Used to generate the sitemap. Leave it unset and the sitemap step is skipped.
# SITE_BASE_URL=

# Example for users of the Claude Code agent CLI (optional) — if you work with a
# different agent, replace this with that tool's environment variables. Telemetry
# sends usage data to that vendor; turn it on only if you have decided you want that.
CLAUDE_CODE_ENABLE_TELEMETRY=0
