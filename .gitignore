# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
/dist-content
/out-tsc
/bazel-out

# Generated content bundles (built by scripts/build-unified-content.ts)
# All language bundles are generated at build time
src/assets/data/content.*.json
src/assets/data/glossary.*.json
src/assets/data/timeline.*.json
src/assets/data/ai-tools.*.json
src/assets/data/ai-resources.*.json
src/assets/data/algorithms.*.json
src/assets/data/sources.*.json
src/assets/data/book-sources.*.json
src/assets/data/interviews.*.json

# Generated notification bundles (built by scripts/sync-notifications.mjs)
# Per-file sources live in src/assets/data/notifications/*.json (committed)
src/assets/data/notifications.compiled.json
src/assets/data/notifications-archive.compiled.json

# Generated compiled glossary per-language files (built by scripts/build-compiled-glossary.ts)
src/assets/data/core/glossary/compiled-glossary.*.json

# Generated i18n bundles (built by scripts/build-i18n-bundles.ts)
src/assets/i18n/i18n.*.json
src/assets/i18n/chunks/

# Node
/node_modules
npm-debug.log
yarn-error.log

# Ad-hoc dev/build scratch logs (ng serve / test runs / build captures)
/tmp-*.log
/test-run.log
*.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Browser test profiles (generated by Karma/Brave)
.chrome-test-profile/

# Auto-generated version files
src/assets/version.json
src/build-version.ts

# Temporary working files (completely ignored)
/tmp/

# Environment variables (use .env.example as template)
.env
.env.*
!.env.example

# Deployment credentials (SFTP)
.deploy-credentials

# Keys, certificates and credential files (SEC-001) — a second net under the safety
# hook and the CI secret scan, so a key dropped into the tree never shows up as
# an untracked file ready to be added.
*.pem
*.key
id_rsa*
id_ed25519*
*.p12
*.pfx
*credentials*.json

# Agent harness — local, per-developer settings. The shared .claude/settings.json IS
# tracked (it wires in the safety hook); the .local. variant is personal overrides and
# often holds machine paths or keys, so it must never be committed.
.claude/settings.local.json
# Runtime lock written by Claude Code scheduled tasks. Unlike the other ignored
# paths this one has a tracked parent, so without this line it shows up as
# untracked noise inside .claude/ the moment scheduled tasks are used.
.claude/scheduled_tasks.lock

# JVM crash dumps (happen during Karma/Brave test runs)
hs_err_pid*.log
replay_pid*.log

# Migration backups
src/assets/data/core/book-sources.backup/
src/assets/data/translations/book-sources.backup/

# Generic backup-file pattern (prevent accidental commits of *.backup files)
*.backup

# Generated build artifacts (regenerated by prebuild:prod — never commit)
/prerender-routes.txt
/public/sitemap.xml
/public/sitemap-main.xml
/public/sitemap-index.xml

# User manifest — describes a person, not the project (PRIV-001). Template ships; the
# filled-in copy stays local. See profile/USER-MANIFEST.template.md.
/profile/USER-MANIFEST.MD

# Pack outputs (out/teacher/, out/editor/, out/researcher/) are deliberately NOT ignored:
# they are the user's own work, and git is their safety net against a wrong clean-up.
# Pupil data never gets there (each pack's GUARDRAILS stops it, PRIV-006); helper scripts
# and screenshots go to /tmp/ above, never beside the material. The kit tools' own output
# under out/ is evidence and build artifacts, not the user's work, so it stays ignored
# (specs/2026-09-25-kit-tools/: screenshots and reports in out/tools/, the site zip in out/site/).
/out/tools/
/out/site/

# Font licences, collected from the @fontsource packages at build time
# (scripts/build-font-licenses.mjs) so the OFL text ships beside the fonts.
src/assets/fonts/LICENSES.txt

# Agent worktrees (Claude Code isolation: worktree) — local scratch checkouts, never committed
.claude/worktrees/
